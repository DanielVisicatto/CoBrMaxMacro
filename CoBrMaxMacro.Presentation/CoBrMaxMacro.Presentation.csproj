<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\Backgrounds\main-background.png" />
		<None Remove="Assets\icon.png" />
		<None Remove="icon.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CoBrMaxMacro.Application\CoBrMaxMacro.Application.csproj" />
		<ProjectReference Include="..\CoBrMaxMacro.Infrastructure\CoBrMaxMacro.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\CoBrMaxMacro.Infrastructure\World\Maps\Data\maps.json">
			<Link>World\Maps\Data\maps.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\Backgrounds\main-background.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Assets\icon.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="icon.png" />
	</ItemGroup>

</Project>
