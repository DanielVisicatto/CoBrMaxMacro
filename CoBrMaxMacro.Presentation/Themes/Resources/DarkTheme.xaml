<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F3F3"/>

    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#333333"/>
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#C42B1C"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#444444"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#353535"/>
    <SolidColorBrush x:Key="ControlPopupBackgroundBrush" Color="#2A2A2A"/>

</ResourceDictionary>