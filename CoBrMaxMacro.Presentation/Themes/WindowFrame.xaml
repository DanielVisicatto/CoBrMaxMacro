<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Moldura cromada -->
    <LinearGradientBrush
        x:Key="ChromeFrameBrush"
        StartPoint="0,0"
        EndPoint="1,1">

        <GradientStop Color="#6F7782"
                      Offset="0.00"/>

        <GradientStop Color="#E1E4E8"
                      Offset="0.18"/>

        <GradientStop Color="#707782"
                      Offset="0.40"/>

        <GradientStop Color="#F2F4F6"
                      Offset="0.62"/>

        <GradientStop Color="#555C66"
                      Offset="0.82"/>

        <GradientStop Color="#AEB4BC"
                      Offset="1.00"/>

    </LinearGradientBrush>

    <!-- Linha interna da moldura -->
    <SolidColorBrush
        x:Key="ChromeInnerBorderBrush"
        Color="#667481"/>

    <!-- Overlay para a imagem de fundo -->
    <SolidColorBrush
        x:Key="BackgroundOverlayBrush"
        Color="#990B0F14"/>

</ResourceDictionary>