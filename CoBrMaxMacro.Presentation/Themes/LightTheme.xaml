<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#DADADA"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F1F1F"/>

    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#C42B1C"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ControlPopupBackgroundBrush" Color="#FFFFFF"/>

</ResourceDictionary>