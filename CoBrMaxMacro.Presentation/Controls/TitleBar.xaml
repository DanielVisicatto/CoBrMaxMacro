<UserControl x:Class="CoBrMaxMacro.Presentation.Controls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent"
          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="46"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="Icon"
               Grid.Column="0"
               Source="/Assets/icon.png"
               Width="22"
               Height="22"
               Margin="14,11,10,0"
               VerticalAlignment="Top"/>

        <TextBlock Grid.Column="1"
                   Text="CoBr Max Macro"
                   VerticalAlignment="Center"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <ComboBox x:Name="ThemeSelector"
                  Grid.Column="2"
                  Width="105"
                  Height="30"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Style="{StaticResource TitleBarComboBoxStyle}"
                  SelectionChanged="ThemeSelector_SelectionChanged">

            <ComboBoxItem Content="System"
                          Style="{StaticResource TitleBarComboBoxItemStyle}"/>

            <ComboBoxItem Content="Light"
                          Style="{StaticResource TitleBarComboBoxItemStyle}"/>

            <ComboBoxItem Content="Dark"
                          Style="{StaticResource TitleBarComboBoxItemStyle}"/>

        </ComboBox>

        <Button Grid.Column="3"
                Style="{StaticResource TitleBarButtonStyle}"
                Content="—"
                Click="MinimizeButton_Click"/>

        <Button Grid.Column="4"
                Style="{StaticResource TitleBarButtonStyle}"
                Content="□"
                Click="MaximizeButton_Click"/>

        <Button Grid.Column="5"
                Margin="0,4,4,4"
                Style="{StaticResource CloseTitleBarButtonStyle}"
                Content="✕"
                Click="CloseButton_Click"/>

    </Grid>

</UserControl>